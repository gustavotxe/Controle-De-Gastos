<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand"
        app:contentInsetStart="8dp">
        <ImageView
            android:id="@+id/backIcon"
            style="@style/Ui.Back"
            app:srcCompat="@drawable/arrow_back_24"
            android:contentDescription="@string/back" />
        <TextView
            android:id="@+id/toolbar_title"
            style="@style/Ui.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/new_transaction"
            android:textColor="@color/white" />
    </androidx.appcompat.widget.Toolbar>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusableInTouchMode="true"
            android:padding="24dp">
            <TextView
                style="@style/Ui.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/form_hint" />
            <TextView
                android:id="@+id/textViewIO"
                style="@style/Ui.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/flow"
                android:labelFor="@id/spinnerIO" />
            <Spinner
                android:id="@+id/spinnerIO"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/field_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:spinnerMode="dropdown" />
            <TextView
                android:id="@+id/textViewFlowEdit"
                style="@style/Ui.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
            <TextView
                android:id="@+id/textView5"
                style="@style/Ui.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/description"
                android:labelFor="@id/DescId" />
            <EditText
                android:id="@+id/DescId"
                style="@style/Ui.Field"
                android:hint="@string/description_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="120"
                android:imeOptions="actionNext" />
            <TextView
                android:id="@+id/textViewValor"
                style="@style/Ui.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/amount"
                android:labelFor="@id/editValue" />
            <EditText
                android:id="@+id/editValue"
                style="@style/Ui.Field"
                android:hint="@string/amount_hint"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:digits="0123456789,."
                android:maxLength="14"
                android:textSize="28sp"
                android:imeOptions="actionNext" />
            <TextView
                android:id="@+id/textViewPay"
                style="@style/Ui.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/payment"
                android:labelFor="@id/spinnerPayment" />
            <Spinner
                android:id="@+id/spinnerPayment"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/field_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:spinnerMode="dropdown" />
            <TextView
                android:id="@+id/textViewCategory"
                style="@style/Ui.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/category"
                android:labelFor="@id/spinnerCategory" />
            <Spinner
                android:id="@+id/spinnerCategory"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/field_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:spinnerMode="dropdown" />
            <TextView
                android:id="@+id/textViewDate"
                style="@style/Ui.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/date"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:focusable="true" />
            <TextView
                android:id="@+id/textDateSelected"
                style="@style/Ui.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/date_placeholder"
                android:minHeight="56dp"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="@drawable/field_background"
                android:focusable="true"
                app:drawableEndCompat="@drawable/baseline_calendar_month"
                app:drawableTint="@color/brand" />
            <TextView
                android:id="@+id/textView9"
                style="@style/Ui.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notes"
                android:labelFor="@id/ObsId" />
            <EditText
                android:id="@+id/ObsId"
                style="@style/Ui.Field"
                android:hint="@string/notes_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"
                android:maxLength="650"
                android:gravity="top|start" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/save_transaction" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/cancel"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
