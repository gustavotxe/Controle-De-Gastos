<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardViewadapter"
    style="@style/Ui.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/DescTv"
            android:maxLines="2"
            android:ellipsize="end"
            style="@style/Ui.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:id="@+id/CtgTv"
            android:maxLines="2"
            android:ellipsize="end"
            style="@style/Ui.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <TextView
                android:id="@+id/textIO"
                style="@style/Ui.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="12dp"
                android:paddingStart="0dp" />
            <TextView
                android:id="@+id/textPayMethod"
                android:maxLines="2"
                android:ellipsize="end"
                style="@style/Ui.Caption"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView
            android:id="@+id/ObsTv"
            android:maxLines="4"
            android:ellipsize="end"
            style="@style/Ui.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:textColor="@color/muted" />
        <TextView
            android:id="@+id/textValue"
            style="@style/Ui.Value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/textData"
                style="@style/Ui.Caption"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />
            <ImageView
                android:id="@+id/editIcon"
                style="@style/Ui.Back"
                android:contentDescription="@string/edit_transaction"
                app:srcCompat="@drawable/ic_edit"
                app:tint="@color/brand" />
            <ImageView
                android:id="@+id/deleteIcon"
                style="@style/Ui.Back"
                android:contentDescription="@string/delete_transaction"
                app:srcCompat="@drawable/baseline_delete_sweep"
                app:tint="@color/chartRed" />
        </LinearLayout>
        <TextView
            android:id="@+id/textMonth"
            style="@style/Ui.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
