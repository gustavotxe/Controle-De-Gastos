<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardViewadapter"
    style="@style/Ui.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/textViewMonth"
            style="@style/Ui.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="12dp"
                android:paddingStart="0dp">
                <TextView
                    style="@style/Ui.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/inflow" />
                <TextView
                    android:id="@+id/text_Inflow"
                    style="@style/Ui.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/chartGreen" />
                <TextView
                    style="@style/Ui.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/outflow"
                    android:layout_marginTop="12dp" />
                <TextView
                    android:id="@+id/text_Outflow"
                    style="@style/Ui.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/chartRed" />
                <TextView
                    style="@style/Ui.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/balance"
                    android:layout_marginTop="12dp" />
                <TextView
                    android:id="@+id/text_Balance"
                    style="@style/Ui.Value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand" />
            </LinearLayout>
            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pie_Chart"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <TextView
            android:id="@+id/textView_details"
            style="@style/Ui.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/month_details"
            android:layout_marginTop="16dp"
            android:textColor="@color/brand" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>