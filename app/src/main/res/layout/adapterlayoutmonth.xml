<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardViewadapter"
    style="@style/Ui.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:id="@+id/textViewMonth"
            style="@style/Ui.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center" />
        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pie_Chart"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:importantForAccessibility="no"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Ui.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/inflow"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_Inflow"
                style="@style/Ui.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/chartGreen"
                android:textSize="16sp" />

            <TextView
                style="@style/Ui.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/outflow"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_Outflow"
                style="@style/Ui.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/chartRed"
                android:textSize="16sp" />

            <TextView
                style="@style/Ui.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/balance"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_Balance"
                style="@style/Ui.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/brand"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textView_details"
            style="@style/Ui.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:text="@string/month_details"
            android:textColor="@color/brand"
            android:textSize="14sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>