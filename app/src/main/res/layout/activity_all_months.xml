<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarMonth"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand"
        app:contentInsetStart="8dp"
        app:contentInsetEnd="12dp"
        app:titleTextColor="@color/white">
        <ImageView
            android:id="@+id/backIconMonth"
            style="@style/Ui.Back"
            android:layout_gravity="start"
            app:srcCompat="@drawable/arrow_back_24"
            android:contentDescription="@string/back" />
        <Spinner
            android:id="@+id/yearSpinner"
            android:layout_width="104dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:backgroundTint="@color/white"
            android:popupBackground="@color/brand"
            android:contentDescription="@string/select_year" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/months_title"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="12dp"
            android:paddingEnd="0dp" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMonths"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false" />
</LinearLayout>