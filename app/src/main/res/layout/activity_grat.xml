<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarGratMonth"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brand"
        app:contentInsetStart="8dp"
        app:contentInsetEnd="12dp"
        app:titleTextColor="@color/white">
        <ImageView
            android:id="@+id/backIconGratActivity"
            style="@style/Ui.Back"
            android:layout_gravity="start"
            app:srcCompat="@drawable/arrow_back_24"
            android:contentDescription="@string/back" />
        <Spinner
            android:id="@+id/yearSpinner"
            android:layout_width="104dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:backgroundTint="@color/white"
            android:popupBackground="@color/brand"
            android:contentDescription="@string/select_year" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/annual_title"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="12dp"
            android:paddingEnd="0dp" />
    </androidx.appcompat.widget.Toolbar>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/annualCard"
        style="@style/Ui.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="12dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">
            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/barGrat"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/annual_title"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/annualTotals"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <include
                android:id="@+id/annualTotals"
                layout="@layout/annual_totals"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>