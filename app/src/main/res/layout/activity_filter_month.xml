<?xml version="1.0" encoding="utf-8"?>
<com.example.controledegastos.ui.TapCloseDrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout_filter"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/page">
            <LinearLayout
                android:id="@+id/fixedMonthHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbarF"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/brand"
                    app:contentInsetStart="8dp"
                    app:contentInsetEnd="12dp"
                    app:titleTextColor="@color/white"
                    android:minHeight="?attr/actionBarSize">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="12dp"
                        android:paddingEnd="0dp"
                        android:id="@+id/monthTitle"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp" />
                </androidx.appcompat.widget.Toolbar>
                <include android:id="@+id/transactionFilterBar" layout="@layout/transaction_filter_bar" />
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Ui.Card"
                    android:layout_margin="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                style="@style/Ui.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/balance"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/total_balance"
                                style="@style/Ui.Value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/money_zero"
                                android:textColor="@color/brand"
                                android:textSize="17sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                style="@style/Ui.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/inflow"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/total_inflow"
                                style="@style/Ui.Value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/money_zero"
                                android:textColor="@color/chartGreen"
                                android:textSize="17sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                style="@style/Ui.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/outflow"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/total_outflow"
                                style="@style/Ui.Value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/money_zero"
                                android:textColor="@color/chartRed"
                                android:textSize="17sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/sectionTitle"
                    style="@style/Ui.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12sp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/transactions"
                    android:textSize="17sp" />
            </LinearLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewF"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="96dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:id="@+id/emptyState"
                    android:visibility="gone"
                    android:padding="16dp"
                    android:layout_gravity="top"
                    android:layout_marginTop="8dp">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/baseline_account_balance"
                        app:tint="@color/brand" />
                    <TextView
                        style="@style/Ui.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_title"
                        android:gravity="center"
                        android:layout_marginTop="16dp" />
                    <TextView
                        style="@style/Ui.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_hint"
                        android:gravity="center"
                        android:textColor="@color/muted"
                        android:layout_marginTop="8dp"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/floatingActionButtonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:text="@string/back"
            android:contentDescription="@string/back"
            android:textColor="@color/white"
            app:icon="@drawable/arrow_back_24"
            app:iconTint="@color/white"
            app:backgroundTint="@color/brand" />
    </FrameLayout>
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_filter"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/nav_menu_filter"
        app:drawerLayoutCornerSize="24dp"
        app:itemIconTint="@color/brand"
        app:itemTextColor="@color/ink"
        app:itemVerticalPadding="6dp"
        app:itemMaxLines="2" />
</com.example.controledegastos.ui.TapCloseDrawerLayout>
